# not git-appropriate. Left local; not committed here.
data/nmrexp/
data/training_nmrexp/
scripts/nmrexp_to_spectro.py

# Bulk-crawl working files (large/streaming/resumable) — committed as gzipped
# snapshots at milestones instead of the raw growing JSONL.
data/bulk/spectra.jsonl
data/bulk/seen_papers.txt

